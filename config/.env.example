#!/usr/bin/env bash
# Example environment variables for development.
# Copy this file to `config/.env` and adjust the values for YOUR machine:
#   cp config/.env.example config/.env
# `config/.env` is git-ignored and loaded by config/bootstrap.php.
# NEVER commit your real `config/.env`.

export APP_NAME="series-list-cakephp"
export DEBUG="true"
export APP_ENCODING="UTF-8"
export APP_DEFAULT_LOCALE="en_US"
export APP_DEFAULT_TIMEZONE="UTC"

# Base URL used to build ABSOLUTE links (redirects, e-mails, etc.).
# Leave it EMPTY in development: CakePHP will auto-detect the host from the
# request, so it works no matter which local domain/port you use
# (e.g. *.test via Herd/Valet, or http://localhost:8765 via `bin/cake server`).
# In PRODUCTION you MUST set the real domain, e.g. https://your-app.com
# (no trailing slash). See bootstrap.php for the HostHeaderMiddleware note.
export APP_FULL_BASE_URL=""

# Generate your own with: bin/cake security generate_salt
# (or any 64-char hex string). Do not reuse this placeholder in production.
export SECURITY_SALT="__CHANGE_ME__generate_a_64_char_hex_salt__"

# SQLite database (absolute path DSN). The leading triple slash means an
# absolute path: sqlite:///<abs-path>.
# Change the path below to the ABSOLUTE path of this project on YOUR machine.
export DATABASE_URL="sqlite:///ABSOLUTE/PATH/TO/series-list-cakephp/data/app.sqlite"
export DATABASE_TEST_URL="sqlite:///ABSOLUTE/PATH/TO/series-list-cakephp/tmp/tests.sqlite"
